# liblolosia 绑定：自研 C ABI 门面（ll_ui_*）。
#
# 门面内部用 RmlUi（视图层：RML/RCSS + flexbox 布局 + data-model 数据绑定），
# RmlUi 的 SDL_GPU 后端出帧（Windows / Linux 上即 Vulkan），字体走 FreeType。
# 四个静态库都在 thirdparty/<目标>/ 下，cinterop 的 libraryPath 由 build.gradle.kts 指向该目录。
#
# 顺序就是链接顺序（静态库按左到右解析未定义符号）：
#   liblolosia -> librmlui -> libfreetype -> libSDL3
#   （门面引用 RmlUi/SDL3；RmlUi 引用 FreeType）
package = moe.lolosia.web.ui.native

headers = lolosia_ui.h
headerFilter = lolosia_ui.h

staticLibraries = liblolosia.a librmlui.a libfreetype.a libSDL3.a
