/* 最小客户端主题。
   取参考项目的浅色暖灰 + 白色卡片 + 柔和蓝主色；只保留移动端需要的最小集。 */

body
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	width: 100%;
	height: 100%;

	font-family: lolosia-ui;
	font-size: 15dp;
	color: #1C1C1E;
	background-color: #F2F2F5;
}

.screen
{
	width: 100%;
	height: 100%;
	padding: 24dp;
	box-sizing: border-box;
	display: block;
}

.screen.scroll
{
	overflow-y: auto;
}

/* RmlUi 的滚动条是真实元素；没有默认样式表时 width:auto 会吃掉几乎整个宽度，
   所以必须把宽度写死。箭头不显示，只保留细轨道与滑块。 */
scrollbarvertical
{
	width: 6dp;
	margin-left: 2dp;
	background-color: #F2F2F5;
}

scrollbarhorizontal
{
	height: 6dp;
	margin-top: 2dp;
	background-color: #F2F2F5;
}

scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack
{
	background-color: #E8E8EC;
	border-radius: 3dp;
}

scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar
{
	min-width: 24dp;
	min-height: 24dp;
	background-color: #C7C7CC;
	border-radius: 3dp;
}

sliderarrowdec,
sliderarrowinc
{
	display: none;
}

.screen.center
{
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.screen.tabbed
{
	padding-bottom: 82dp;
}

.title
{
	display: block;
	width: 100%;
	font-size: 22dp;
	color: #1C1C1E;
	margin: 0 0 6dp 0;
}

.subtitle
{
	display: block;
	width: 360dp;
	font-size: 14dp;
	color: #6E6E73;
	margin: 0 0 24dp 0;
}

.section-title
{
	display: block;
	width: 100%;
	font-size: 13dp;
	color: #6E6E73;
	margin: 8dp 0 10dp 0;
}

.muted
{
	display: block;
	width: 360dp;
	color: #6E6E73;
	white-space: normal;
}

.error
{
	display: block;
	font-size: 14dp;
	color: #E05D5D;
	margin: 4dp 0 12dp 0;
}

.card
{
	display: block;
	width: 100%;
	box-sizing: border-box;
	background-color: #F8F8FA;
	border: 1dp #D1D1D6;
	border-radius: 16dp;
	padding: 20dp;
	margin-bottom: 16dp;
}

.card-title
{
	display: block;
	font-size: 16dp;
	color: #1C1C1E;
	margin: 0 0 12dp 0;
}

.row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.grow
{
	flex: 1;
}

.spacer-8
{
	display: block;
	height: 8dp;
}

.spacer-16
{
	display: block;
	height: 16dp;
}

.spacer-24
{
	display: block;
	height: 24dp;
}

.divider
{
	display: block;
	height: 1dp;
	background-color: #D1D1D6;
	margin: 16dp 0;
}

.field
{
	display: block;
	margin-bottom: 16dp;
}

.label
{
	display: block;
	font-size: 13dp;
	color: #6E6E73;
	margin: 0 0 6dp 0;
}

input.text,
input.password
{
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 46dp;
	padding: 0 14dp;
	border-radius: 8dp;
	background-color: #FFFFFF;
	border: 1dp #D1D1D6;
	color: #1C1C1E;
	font-size: 15dp;
}

input.text:hover,
input.password:hover
{
	border-color: #B3CCF2;
}

input.text:focus,
input.password:focus
{
	border-color: #4A8FE7;
}

button
{
	display: inline-block;
	box-sizing: border-box;
	height: 46dp;
	padding: 0 22dp;
	border-radius: 8dp;
	background-color: #4A8FE7;
	border: 0;
	color: #F8F8FA;
	font-size: 15dp;
	cursor: pointer;
}

button:hover
{
	background-color: #2D5F9E;
}

button:active
{
	background-color: #1A3A6B;
}

button.secondary
{
	background-color: #FFFFFF;
	color: #4A8FE7;
	border: 1dp #4A8FE7;
}

button.secondary:hover
{
	background-color: #B3CCF2;
}

button.ghost
{
	background-color: transparent;
	color: #6E6E73;
	border: 0;
}

button.ghost:hover
{
	background-color: #E8E8EC;
}

button.block
{
	display: block;
	width: 100%;
}

.avatar
{
	display: flex;
	width: 72dp;
	height: 72dp;
	align-items: center;
	justify-content: center;
	border-radius: 36dp;
	background-color: #B3CCF2;
	color: #1A3A6B;
	font-size: 28dp;
	margin: 0 auto 12dp auto;
}

.avatar-img
{
	display: block;
	width: 72dp;
	height: 72dp;
	border-radius: 36dp;
	margin: 0 auto 12dp auto;
}

.profile-name
{
	display: block;
	font-size: 20dp;
	color: #1C1C1E;
	text-align: center;
	margin: 0 0 4dp 0;
}

.profile-role
{
	display: block;
	font-size: 13dp;
	color: #6E6E73;
	text-align: center;
	margin: 0 0 20dp 0;
}

.info-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 10dp;
}

.info-label
{
	display: inline-block;
	width: 72dp;
	font-size: 14dp;
	color: #6E6E73;
}

.info-value
{
	display: inline-block;
	flex: 1;
	font-size: 14dp;
	color: #1C1C1E;
}

.metric-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 8dp;
}

.metric
{
	display: inline-block;
	flex: 1;
	font-size: 13dp;
	color: #6E6E73;
}

.tabbar
{
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	width: 100%;
	height: 58dp;
	display: block;
	background-color: #F8F8FA;
	border-top: 1dp #D1D1D6;
}

.tab
{
	display: block;
	float: left;
	width: 50%;
	height: 58dp;
	line-height: 58dp;
	text-align: center;
	font-size: 14dp;
	color: #6E6E73;
}

.tab.active
{
	color: #4A8FE7;
}

.content
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 58dp;
	width: 100%;
	padding: 24dp;
	box-sizing: border-box;
	overflow-y: auto;
}

.loading
{
	display: block;
	font-size: 14dp;
	color: #6E6E73;
	margin: 12dp 0;
}

.badge
{
	display: inline-block;
	padding: 3dp 10dp;
	border-radius: 999dp;
	font-size: 12dp;
	background-color: #B3CCF2;
	color: #1A3A6B;
}

.list-table
{
	display: table;
	width: 100%;
	border-collapse: collapse;
}

.list-row
{
	display: table-row;
}

.list-table td
{
	display: table-cell;
	padding: 10dp 0;
	border-bottom: 1dp #E8E8EC;
	vertical-align: middle;
}

.list-cover-cell
{
	width: 52dp;
}

.list-index
{
	display: inline-block;
	width: 32dp;
	font-size: 13dp;
	color: #6E6E73;
	vertical-align: middle;
}

.list-cover
{
	display: inline-block;
	width: 36dp;
	height: 50dp;
	margin-right: 10dp;
	border-radius: 8dp;
	background-color: #B3CCF2;
	color: #1A3A6B;
	font-size: 15dp;
	line-height: 50dp;
	text-align: center;
	vertical-align: middle;
}

.list-cover-img
{
	display: inline-block;
	width: 36dp;
	height: 50dp;
	margin-right: 10dp;
	border-radius: 8dp;
	vertical-align: middle;
}

.list-main
{
	width: 100%;
}

.list-title
{
	display: block;
	width: 100%;
	font-size: 15dp;
	color: #1C1C1E;
	white-space: nowrap;
}

.list-meta
{
	display: block;
	width: 100%;
	margin-top: 4dp;
	font-size: 12dp;
	color: #6E6E73;
	white-space: nowrap;
}
