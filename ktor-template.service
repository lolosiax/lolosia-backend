[Unit]
Description=洛洛希雅的Ktor后端 (ktor-template)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/ktor-template
# 由部署插件在推送时把 jar 指向替换为当前版本（无需固定 app.jar）
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /srv/ktor-template/ktor-template-1.0.0-SNAPSHOT-fat.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
