# anime-relay 配置（部署到 /srv/anime-relay/relay.env，权限 600）
# 依赖：python3-msgpack（apt install python3-msgpack，或 pip install msgpack）—— 正文走自定义请求通道
# RELAY_TOKEN 必填：墙内后端与本服务的共享令牌，用 openssl rand -hex 24 生成
RELAY_TOKEN=change-me
RELAY_HOST=0.0.0.0
RELAY_PORT=8790
# 收到 notify 后，隔多久才真正出站（秒）；再叠加 0..RELAY_JITTER_SECONDS 的随机抖动
RELAY_DELAY_SECONDS=180
RELAY_JITTER_SECONDS=120
RELAY_TARGET_URL=https://api.bgm.tv/calendar
RELAY_UA=lolosia-anime/1.0 (+http://lolosia.moe)
RELAY_TIMEOUT_SECONDS=30
RELAY_STATE_FILE=/srv/anime-relay/state.json
